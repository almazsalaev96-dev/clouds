{
  "name": "understory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "An AI-native personal knowledge, learning, research and work environment.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --test --test-timeout=30000 packages/core/test/*.test.ts packages/server/test/*.test.ts",
    "test:unit": "node --test packages/core/test/*.test.ts",
    "test:api": "node --test packages/server/test/api.test.ts",
    "test:ui": "node --test --test-timeout=30000 packages/server/test/browser.test.ts",
    "start": "node packages/server/src/main.ts",
    "dev": "node --watch packages/server/src/main.ts",
    "build": "node tools/build-vercel.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.123.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "playwright-core": "^1.62.1"
  }
}
