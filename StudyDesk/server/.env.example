# Study Desk proxy configuration.
#
# Copy to .env and fill in. Never commit .env — it is gitignored.
# These two keys are the entire reason this server exists: they stay here and
# are never sent to the iPad.

# --- Required for the tutor ---
ANTHROPIC_API_KEY=
# Vision + fast streaming. See docs/architecture.md before changing.
TUTOR_MODEL=claude-sonnet-5
TUTOR_MAX_TOKENS=1024

# --- Required for voice ---
ELEVENLABS_API_KEY=
# The tutor's voice. Chosen server-side so it can change without an app release.
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

# --- Required in production ---
# Signs anonymous device tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If unset, one is generated per run and every device must re-register on restart.
TOKEN_SECRET=

# --- Optional ---
PORT=8787
HOST=0.0.0.0
NODE_ENV=development
RATE_TUTOR_PER_MINUTE=20
RATE_VOICE_PER_MINUTE=12
RATE_REGISTER_PER_HOUR=30
