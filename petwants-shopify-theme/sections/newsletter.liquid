<section class="section">
  <div class="page-width">
    <div class="newsletter">
      <div>
        <h2>{{ section.settings.heading }}</h2>
        <p style="margin:0;">{{ section.settings.text }}</p>
      </div>
      <div>
        {%- form 'customer', id: 'NewsletterForm' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          {%- if form.posted_successfully? -%}
            <div class="form-message form-message--success">{% render 'icon', icon: 'check', class: 'icon--sm' %} {{ section.settings.success }}</div>
          {%- else -%}
            {%- if form.errors -%}<div class="form-message form-message--error">{{ form.errors | default_errors }}</div>{%- endif -%}
            <div class="newsletter__form">
              <label for="NewsletterEmail" class="visually-hidden">Email</label>
              <input id="NewsletterEmail" class="input" type="email" name="contact[email]" autocomplete="email" placeholder="Enter your email" required>
              <button type="submit" class="btn btn--dark">Sign up</button>
            </div>
            <p class="newsletter__fine">{{ section.settings.fine_print }}</p>
          {%- endif -%}
        {%- endform -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Get deals & pet-care tips" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Be first to know about sales, new arrivals and expert advice for happier, healthier pets." },
    { "type": "text", "id": "fine_print", "label": "Fine print", "default": "Unsubscribe anytime. We never sell your data." },
    { "type": "text", "id": "success", "label": "Success message", "default": "You're signed up — welcome to the pack!" }
  ],
  "presets": [ { "name": "Newsletter" } ]
}
{% endschema %}
