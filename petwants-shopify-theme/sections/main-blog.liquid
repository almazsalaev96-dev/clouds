<div class="page-width section">
  <h1>{{ blog.title }}</h1>
  {%- paginate blog.articles by 12 -%}
    <div class="article-grid">
      {%- for article in blog.articles -%}
        <article class="article-card">
          <a href="{{ article.url }}" tabindex="-1" aria-hidden="true">
            {%- if article.image -%}{{ article.image | image_url: width: 800 | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 33vw, 100vw', widths: '400, 600, 800', alt: '' }}{%- else -%}{{ 'lifestyle-1' | placeholder_svg_tag }}{%- endif -%}
          </a>
          <div class="article-card__body">
            <small>{{ article.published_at | date: '%b %d, %Y' }}</small>
            <h3><a href="{{ article.url }}">{{ article.title }}</a></h3>
            <p class="muted" style="margin:0;">{{ article.excerpt_or_content | strip_html | truncate: 130 }}</p>
          </div>
        </article>
      {%- endfor -%}
    </div>
    {% render 'pagination', paginate: paginate %}
  {%- endpaginate -%}
</div>

{% schema %}
{ "name": "Blog posts", "tag": "section" }
{% endschema %}
