<div class="page-width not-found">
  <img src="{{ 'petwants-logo.png' | asset_url }}" alt="{{ shop.name | escape }}" width="320" height="237" style="width:320px;">
  <h1>{{ section.settings.heading }}</h1>
  {%- if shop.password_message != blank -%}<p class="muted">{{ shop.password_message }}</p>{%- endif -%}
  <div style="max-width:460px;margin:22px auto 0;">
    {%- form 'customer' -%}
      <input type="hidden" name="contact[tags]" value="prelaunch">
      {%- if form.posted_successfully? -%}
        <div class="form-message form-message--success">You're on the list — we'll email you at launch.</div>
      {%- else -%}
        <div class="newsletter__form">
          <label for="PwEmail" class="visually-hidden">Email</label>
          <input id="PwEmail" class="input" type="email" name="contact[email]" placeholder="Email for launch updates" required>
          <button type="submit" class="btn btn--brand">Notify me</button>
        </div>
      {%- endif -%}
    {%- endform -%}
  </div>
  <details style="margin-top:32px;">
    <summary class="link" style="cursor:pointer;">Store owner? Enter password</summary>
    {%- form 'storefront_password' -%}
      {%- if form.errors -%}<div class="form-message form-message--error" style="margin-top:12px;">{{ form.errors | default_errors }}</div>{%- endif -%}
      <div class="newsletter__form" style="max-width:460px;margin:12px auto 0;">
        <label for="Password" class="visually-hidden">Password</label>
        <input id="Password" class="input" type="password" name="password" autocomplete="current-password" placeholder="Password">
        <button type="submit" class="btn btn--dark">Enter</button>
      </div>
    {%- endform -%}
  </details>
</div>

{% schema %}
{
  "name": "Password page",
  "tag": "section",
  "settings": [ { "type": "text", "id": "heading", "label": "Heading", "default": "Something pawsome is coming soon" } ]
}
{% endschema %}
