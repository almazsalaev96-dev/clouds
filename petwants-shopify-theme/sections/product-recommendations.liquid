<section class="section{% if section.settings.alt_bg %} section--alt{% endif %}" data-recommendations data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.limit }}&intent={{ section.settings.intent }}">
  {%- if recommendations.performed and recommendations.products_count > 0 -%}
    <div class="page-width">
      <div class="section-head"><h2>{{ section.settings.heading }}</h2></div>
      <div class="carousel" data-carousel style="--per-row: 6;">
        <button type="button" class="carousel__arrow carousel__arrow--prev" data-carousel-prev aria-label="Previous products">{% render 'icon', icon: 'chevron-left' %}</button>
        <ul class="carousel__track" data-carousel-track role="list" style="list-style:none;margin:0;">
          {%- for rec in recommendations.products -%}
            <li>{% render 'product-card', product: rec %}</li>
          {%- endfor -%}
        </ul>
        <button type="button" class="carousel__arrow carousel__arrow--next" data-carousel-next aria-label="Next products">{% render 'icon', icon: 'chevron-right' %}</button>
      </div>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Product recommendations",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Customers also bought" },
    { "type": "select", "id": "intent", "label": "Type", "options": [ { "value": "related", "label": "Related products" }, { "value": "complementary", "label": "Complementary (goes well with)" } ], "default": "related", "info": "Complementary products are set with the Search & Discovery app." },
    { "type": "range", "id": "limit", "min": 4, "max": 10, "step": 1, "label": "Products", "default": 10 },
    { "type": "checkbox", "id": "alt_bg", "label": "Soft background", "default": false }
  ],
  "presets": [ { "name": "Product recommendations" } ]
}
{% endschema %}
