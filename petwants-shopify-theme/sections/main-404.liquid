<div class="page-width not-found">
  <img src="{{ 'petwants-mark.png' | asset_url }}" alt="" width="180" height="210" loading="lazy">
  <h1>Oops — this page ran off to chase a squirrel</h1>
  <p class="muted">The page you're looking for doesn't exist or has moved.</p>
  <form action="{{ routes.search_url }}" method="get" role="search" class="search-form not-found__search">
    <label for="NotFoundSearch" class="visually-hidden">Search</label>
    <input id="NotFoundSearch" class="search-form__input" type="search" name="q" placeholder="Search products">
    <button type="submit" class="search-form__btn" aria-label="Search">{% render 'icon', icon: 'search', class: 'icon--sm' %}</button>
  </form>
  <p style="margin-top:22px;"><a href="{{ routes.root_url }}" class="btn btn--brand">Back to home</a></p>
</div>

{% schema %}
{ "name": "404", "tag": "section" }
{% endschema %}
