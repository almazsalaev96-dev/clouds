<section class="section section--tight{% if section.settings.alt_bg %} section--alt{% endif %}">
  <div class="page-width">
    <div class="trust-bar" style="--cols: {{ section.blocks.size | at_most: 4 | at_least: 1 }};">
      {%- for block in section.blocks -%}
        {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}" class="trust-item" {{ block.shopify_attributes }}>{%- else -%}<div class="trust-item" {{ block.shopify_attributes }}>{%- endif -%}
          <span class="trust-item__icon">{% render 'icon', icon: block.settings.icon %}</span>
          <div><strong>{{ block.settings.title }}</strong><span>{{ block.settings.text }}</span></div>
        {%- if block.settings.link != blank -%}</a>{%- else -%}</div>{%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Trust bar",
  "tag": "div",
  "max_blocks": 4,
  "settings": [ { "type": "checkbox", "id": "alt_bg", "label": "Soft background", "default": true } ],
  "blocks": [
    {
      "type": "item",
      "name": "Promise",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "options": [
          { "value": "truck", "label": "Truck" }, { "value": "return", "label": "Return" }, { "value": "phone", "label": "Phone" },
          { "value": "chat", "label": "Chat" }, { "value": "shield", "label": "Shield" }, { "value": "lock", "label": "Lock" },
          { "value": "autoship", "label": "Autoship" }, { "value": "vet", "label": "Vet" }, { "value": "award", "label": "Award" },
          { "value": "leaf", "label": "Leaf" }, { "value": "gift", "label": "Gift" }, { "value": "clock", "label": "Clock" }, { "value": "paw", "label": "Paw" }
        ], "default": "truck" },
        { "type": "text", "id": "title", "label": "Title", "default": "Free shipping $49+" },
        { "type": "text", "id": "text", "label": "Text", "default": "Fast delivery to your door" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [ { "name": "Trust bar", "blocks": [ { "type": "item" }, { "type": "item", "settings": { "icon": "return", "title": "Easy returns", "text": "Hassle-free, no questions asked" } }, { "type": "item", "settings": { "icon": "phone", "title": "Real pet experts", "text": "Call, text or chat 7 days a week" } }, { "type": "item", "settings": { "icon": "lock", "title": "Secure checkout", "text": "Encrypted & protected" } } ] } ]
}
{% endschema %}
