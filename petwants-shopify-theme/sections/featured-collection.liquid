{%- liquid
  assign collection = section.settings.collection
  assign limit = section.settings.limit
-%}
<section class="section{% if section.settings.alt_bg %} section--alt{% endif %}">
  <div class="page-width">
    <div class="section-head">
      <div>
        <h2>{{ section.settings.heading | default: collection.title }}</h2>
        {%- if section.settings.subheading != blank -%}<p class="section-head__sub">{{ section.settings.subheading }}</p>{%- endif -%}
      </div>
      {%- if collection != blank and section.settings.show_link -%}
        <a href="{{ collection.url }}" class="section-head__link">Shop all →</a>
      {%- endif -%}
    </div>
    {%- if section.settings.layout == 'carousel' -%}
      <div class="carousel" data-carousel style="--per-row: {{ section.settings.per_row }};">
        <button type="button" class="carousel__arrow carousel__arrow--prev" data-carousel-prev aria-label="Previous products">{% render 'icon', icon: 'chevron-left' %}</button>
        <ul class="carousel__track" data-carousel-track role="list" style="list-style:none;margin:0;">
          {%- if collection != blank and collection.products_count > 0 -%}
            {%- for product in collection.products limit: limit -%}
              <li>{% render 'product-card', product: product %}</li>
            {%- endfor -%}
          {%- else -%}
            {%- for i in (1..6) -%}
              <li><div class="card"><div class="card__media">{{ 'product-apparel-2' | placeholder_svg_tag }}</div><div class="card__vendor">Brand</div><h3 class="card__title">Product title</h3><div class="price"><span class="price__current">{{ 2999 | money }}</span></div></div></li>
            {%- endfor -%}
          {%- endif -%}
        </ul>
        <button type="button" class="carousel__arrow carousel__arrow--next" data-carousel-next aria-label="Next products">{% render 'icon', icon: 'chevron-right' %}</button>
      </div>
    {%- else -%}
      <ul class="product-grid" role="list" style="--cols: {{ section.settings.per_row | at_most: 5 }};">
        {%- for product in collection.products limit: limit -%}
          <li>{% render 'product-card', product: product %}</li>
        {%- else -%}
          {%- for i in (1..4) -%}
            <li><div class="card"><div class="card__media">{{ 'product-apparel-2' | placeholder_svg_tag }}</div><h3 class="card__title">Product title</h3></div></li>
          {%- endfor -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Product carousel",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Today's top deals" },
    { "type": "text", "id": "subheading", "label": "Subheading" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "min": 4, "max": 24, "step": 1, "label": "Products to show", "default": 12 },
    { "type": "select", "id": "layout", "label": "Layout", "options": [ { "value": "carousel", "label": "Swipe carousel" }, { "value": "grid", "label": "Grid" } ], "default": "carousel" },
    { "type": "range", "id": "per_row", "min": 3, "max": 6, "step": 1, "label": "Products per row (desktop)", "default": 6 },
    { "type": "checkbox", "id": "show_link", "label": "Show \"Shop all\" link", "default": true },
    { "type": "checkbox", "id": "alt_bg", "label": "Soft background", "default": false }
  ],
  "presets": [ { "name": "Product carousel" } ]
}
{% endschema %}
