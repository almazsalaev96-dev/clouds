<div class="page-width section">
  <p><a class="link" href="{{ routes.account_url }}">← Back to account</a></p>
  <h1>Order {{ order.name }}</h1>
  <p class="muted">Placed {{ order.created_at | date: '%B %d, %Y at %-I:%M %p' }}</p>
  {%- if order.cancelled -%}<div class="form-message form-message--error">Cancelled on {{ order.cancelled_at | date: '%B %d, %Y' }}: {{ order.cancel_reason_label }}</div>{%- endif -%}
  <div class="account-grid">
    <div class="card-box table-wrap">
      <table class="data-table">
        <thead><tr><th>Product</th><th>Price</th><th>Qty</th><th>Total</th></tr></thead>
        <tbody>
          {%- for line_item in order.line_items -%}
            <tr>
              <td>
                {{ line_item.title | link_to: line_item.product.url }}
                {%- if line_item.selling_plan_allocation -%}<br><small class="muted">{{ line_item.selling_plan_allocation.selling_plan.name }}</small>{%- endif -%}
                {%- if line_item.fulfillment -%}<br><small class="muted">Shipped {{ line_item.fulfillment.created_at | date: '%b %d' }}{% if line_item.fulfillment.tracking_url %} · <a class="link" href="{{ line_item.fulfillment.tracking_url }}" target="_blank" rel="noopener">Track package</a>{% endif %}</small>{%- endif -%}
              </td>
              <td>{{ line_item.final_price | money }}</td>
              <td>{{ line_item.quantity }}</td>
              <td>{{ line_item.final_line_price | money }}</td>
            </tr>
          {%- endfor -%}
        </tbody>
        <tfoot>
          <tr><td colspan="3">Subtotal</td><td>{{ order.line_items_subtotal_price | money }}</td></tr>
          {%- for discount in order.cart_level_discount_applications -%}<tr><td colspan="3">Discount ({{ discount.title }})</td><td>−{{ discount.total_allocated_amount | money }}</td></tr>{%- endfor -%}
          {%- for shipping_method in order.shipping_methods -%}<tr><td colspan="3">Shipping ({{ shipping_method.title }})</td><td>{{ shipping_method.price | money }}</td></tr>{%- endfor -%}
          {%- for tax_line in order.tax_lines -%}<tr><td colspan="3">Tax ({{ tax_line.title }})</td><td>{{ tax_line.price | money }}</td></tr>{%- endfor -%}
          <tr><td colspan="3"><strong>Total</strong></td><td><strong>{{ order.total_price | money_with_currency }}</strong></td></tr>
        </tfoot>
      </table>
    </div>
    <div style="display:grid;gap:16px;align-content:start;">
      <div class="card-box"><h2 style="font-size:1.1rem;">Shipping address</h2><p style="font-size:.92rem;">{{ order.shipping_address | format_address }}</p><p class="muted" style="font-size:.9rem;">{{ order.fulfillment_status_label }}</p></div>
      <div class="card-box"><h2 style="font-size:1.1rem;">Billing address</h2><p style="font-size:.92rem;">{{ order.billing_address | format_address }}</p><p class="muted" style="font-size:.9rem;">{{ order.financial_status_label }}</p></div>
    </div>
  </div>
</div>

{% schema %}
{ "name": "Order", "tag": "section" }
{% endschema %}
