<section class="section">
  <div class="page-width">
    <div class="section-head">
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.link != blank -%}<a href="{{ section.settings.link }}" class="section-head__link">All brands →</a>{%- endif -%}
    </div>
    <div class="brands">
      {%- for block in section.blocks -%}
        <a href="{{ block.settings.link | default: '#' }}" class="brand-tile" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 320 | image_tag: loading: 'lazy', alt: block.settings.name, sizes: '160px', widths: '160, 320' }}
          {%- else -%}
            {{ block.settings.name }}
          {%- endif -%}
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Brands",
  "tag": "div",
  "max_blocks": 18,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop top brands" },
    { "type": "url", "id": "link", "label": "\"All brands\" link" }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Brand",
      "settings": [
        { "type": "text", "id": "name", "label": "Name", "default": "Brand" },
        { "type": "image_picker", "id": "image", "label": "Logo" },
        { "type": "url", "id": "link", "label": "Link", "info": "Tip: link to /collections/vendors?q=BrandName" }
      ]
    }
  ],
  "presets": [ { "name": "Brands", "blocks": [ { "type": "brand" }, { "type": "brand" }, { "type": "brand" }, { "type": "brand" }, { "type": "brand" }, { "type": "brand" } ] } ]
}
{% endschema %}
