<div class="page-width section">
  <p><a class="link" href="{{ routes.account_url }}">← Back to account</a></p>
  <h1>Your addresses</h1>
  <div class="account-grid">
    <div style="display:grid;gap:16px;align-content:start;">
      {%- paginate customer.addresses by 10 -%}
        {%- for address in customer.addresses -%}
          <div class="card-box">
            {%- if address == customer.default_address -%}<span class="badge badge--trust">Default</span>{%- endif -%}
            <p style="margin-top:8px;">{{ address | format_address }}</p>
            <details>
              <summary class="link" style="cursor:pointer;">Edit</summary>
              {%- form 'customer_address', address -%}
                {% render 'address-fields', form: form, prefix: address.id %}
                <button type="submit" class="btn btn--dark btn--sm">Save address</button>
              {%- endform -%}
            </details>
            <form method="post" action="{{ address.url }}" style="margin-top:8px;" onsubmit="return confirm('Delete this address?');">
              <input type="hidden" name="_method" value="delete">
              <button type="submit" class="cart-item__remove">Delete</button>
            </form>
          </div>
        {%- endfor -%}
        {% render 'pagination', paginate: paginate %}
      {%- endpaginate -%}
    </div>
    <div class="card-box">
      <h2 style="font-size:1.15rem;">Add a new address</h2>
      {%- form 'customer_address', customer.new_address -%}
        {% render 'address-fields', form: form, prefix: 'new' %}
        <button type="submit" class="btn btn--brand btn--full">Add address</button>
      {%- endform -%}
    </div>
  </div>
</div>

{% schema %}
{ "name": "Addresses", "tag": "section" }
{% endschema %}
