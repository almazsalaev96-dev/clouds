<section class="section" data-recently-viewed data-limit="{{ section.settings.limit }}" hidden>
  <div class="page-width">
    <div class="section-head"><h2>{{ section.settings.heading }}</h2></div>
    <div class="carousel" data-carousel style="--per-row: 6;">
      <ul class="carousel__track" data-carousel-track data-recent-track role="list" style="list-style:none;margin:0;"></ul>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Recently viewed",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Recently viewed" },
    { "type": "range", "id": "limit", "min": 3, "max": 12, "step": 1, "label": "Products", "default": 8 }
  ],
  "presets": [ { "name": "Recently viewed" } ]
}
{% endschema %}
