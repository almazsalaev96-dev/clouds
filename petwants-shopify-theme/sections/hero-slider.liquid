<section class="section section--tight" {{ section.shopify_attributes }}>
  <div class="page-width">
    <div class="hero" data-slider data-autoplay="{{ section.settings.autoplay }}" data-interval="{{ section.settings.interval | times: 1000 }}" style="--hero-h: {{ section.settings.height }}px; --hero-h-mobile: {{ section.settings.height_mobile }}px;" aria-roledescription="carousel" aria-label="Featured promotions">
      <div class="hero__viewport">
        <div class="hero__track" data-slider-track>
          {%- for block in section.blocks -%}
            <div class="hero__slide{% if block.settings.overlay %} hero__slide--overlay{% endif %}" style="--slide-bg: {{ block.settings.bg }}; --slide-fg: {{ block.settings.fg }};" role="group" aria-roledescription="slide" aria-label="{{ forloop.index }} of {{ forloop.length }}" {{ block.shopify_attributes }}>
              <div class="hero__media">
                {%- if block.settings.image != blank -%}
                  {%- liquid
                    assign img_loading = 'lazy'
                    assign img_priority = 'auto'
                    if forloop.first
                      assign img_loading = 'eager'
                      assign img_priority = 'high'
                    endif
                    assign img_alt = block.settings.image.alt | default: block.settings.heading
                  -%}
                  <picture>
                    {%- if block.settings.image_mobile != blank -%}
                      <source media="(max-width: 749px)" srcset="{{ block.settings.image_mobile | image_url: width: 750 }} 750w, {{ block.settings.image_mobile | image_url: width: 1100 }} 1100w" sizes="100vw">
                    {%- endif -%}
                    {{ block.settings.image | image_url: width: 2400 | image_tag: loading: img_loading, fetchpriority: img_priority, sizes: '100vw', widths: '750, 1100, 1500, 1800, 2400', alt: img_alt }}
                  </picture>
                {%- else -%}
                  {{ 'lifestyle-1' | placeholder_svg_tag }}
                {%- endif -%}
              </div>
              <div class="hero__content hero__content--{{ block.settings.align }}">
                {%- if block.settings.eyebrow != blank -%}<span class="hero__eyebrow">{{ block.settings.eyebrow }}</span>{%- endif -%}
                {%- if block.settings.heading != blank -%}<h2 class="hero__heading">{{ block.settings.heading }}</h2>{%- endif -%}
                {%- if block.settings.text != blank -%}<div class="hero__text">{{ block.settings.text }}</div>{%- endif -%}
                {%- if block.settings.button_label != blank -%}
                  <a href="{{ block.settings.button_link | default: routes.all_products_collection_url }}" class="btn btn--{{ block.settings.button_style }} btn--lg">{{ block.settings.button_label }}</a>
                {%- endif -%}
                {%- if block.settings.fine_print != blank -%}<p class="hero__fine">{{ block.settings.fine_print }}</p>{%- endif -%}
              </div>
            </div>
          {%- endfor -%}
        </div>
      </div>
      {%- if section.blocks.size > 1 -%}
        <button type="button" class="hero__arrow hero__arrow--prev" data-slider-prev aria-label="Previous slide">{% render 'icon', icon: 'chevron-left' %}</button>
        <button type="button" class="hero__arrow hero__arrow--next" data-slider-next aria-label="Next slide">{% render 'icon', icon: 'chevron-right' %}</button>
        <div class="hero__controls">
          {%- if section.settings.autoplay -%}
            <button type="button" class="hero__pause" data-slider-pause aria-label="Pause slideshow">{% render 'icon', icon: 'pause', class: 'icon--sm' %}</button>
          {%- endif -%}
          {%- for block in section.blocks -%}
            <button type="button" class="hero__dot{% if forloop.first %} is-active{% endif %}" data-slider-dot="{{ forloop.index0 }}" aria-label="Go to slide {{ forloop.index }}"></button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero slider",
  "tag": "div",
  "max_blocks": 6,
  "settings": [
    { "type": "range", "id": "height", "min": 300, "max": 640, "step": 20, "unit": "px", "label": "Height (desktop)", "default": 440 },
    { "type": "range", "id": "height_mobile", "min": 300, "max": 640, "step": 20, "unit": "px", "label": "Height (mobile)", "default": 460 },
    { "type": "checkbox", "id": "autoplay", "label": "Auto-rotate", "default": true },
    { "type": "range", "id": "interval", "min": 4, "max": 12, "step": 1, "unit": "s", "label": "Rotate every", "default": 6 }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image", "info": "2400 × 880px recommended. Keep the left side calm for text." },
        { "type": "image_picker", "id": "image_mobile", "label": "Mobile image", "info": "750 × 920px" },
        { "type": "checkbox", "id": "overlay", "label": "Darken image behind text", "default": false },
        { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "New customers" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Everything your pet wants, delivered" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Food, treats, toys and health essentials from brands you trust.</p>" },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop now" },
        { "type": "url", "id": "button_link", "label": "Button link" },
        { "type": "select", "id": "button_style", "label": "Button style", "options": [ { "value": "brand", "label": "Brand" }, { "value": "dark", "label": "Dark" }, { "value": "light", "label": "White" }, { "value": "trust", "label": "Trust blue" } ], "default": "brand" },
        { "type": "text", "id": "fine_print", "label": "Fine print", "info": "Offer terms, e.g. \"New customers only. Ends 10/31.\"" },
        { "type": "select", "id": "align", "label": "Text position", "options": [ { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" } ], "default": "left" },
        { "type": "color", "id": "bg", "label": "Background", "default": "#F6E7D6" },
        { "type": "color", "id": "fg", "label": "Text", "default": "#262626" }
      ]
    }
  ],
  "presets": [ { "name": "Hero slider", "blocks": [ { "type": "slide" }, { "type": "slide" } ] } ]
}
{% endschema %}
