<div class="page-width section">
  <h1>{{ section.settings.heading }}</h1>
  <div class="collection-list">
    {%- for collection in collections -%}
      <a href="{{ collection.url }}" class="collection-tile">
        {%- if collection.featured_image -%}{{ collection.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 25vw, 50vw', widths: '300, 450, 600', alt: '' }}{%- else -%}{{ 'collection-1' | placeholder_svg_tag }}{%- endif -%}
        <span>{{ collection.title }}</span>
      </a>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Collections list",
  "tag": "section",
  "settings": [ { "type": "text", "id": "heading", "label": "Heading", "default": "Shop all categories" } ]
}
{% endschema %}
