{%- comment -%} Cart line items, shared by the cart page and the cart drawer. {%- endcomment -%}
<ul class="cart-items" role="list">
  {%- for item in cart.items -%}
    <li class="cart-item" data-line="{{ forloop.index }}" data-key="{{ item.key }}">
      <a href="{{ item.url }}" class="cart-item__img" tabindex="-1" aria-hidden="true">
        {%- if item.image -%}
          {{ item.image | image_url: width: 200 | image_tag: loading: 'lazy', alt: item.product.title }}
        {%- endif -%}
      </a>
      <div>
        {%- if item.vendor != blank -%}<p class="cart-item__meta"><strong>{{ item.vendor }}</strong></p>{%- endif -%}
        <a href="{{ item.url }}" class="cart-item__title">{{ item.product.title }}</a>
        {%- unless item.product.has_only_default_variant -%}
          <p class="cart-item__meta">
            {%- for option in item.options_with_values -%}{{ option.name }}: {{ option.value }}{% unless forloop.last %} · {% endunless %}{%- endfor -%}
          </p>
        {%- endunless -%}
        {%- if item.selling_plan_allocation -%}
          <span class="cart-item__plan">{% render 'icon', icon: 'autoship' %}{{ item.selling_plan_allocation.selling_plan.name }}</span>
        {%- endif -%}
        {%- for property in item.properties -%}
          {%- assign first_char = property.first | slice: 0 -%}
          {%- if property.last != blank and first_char != '_' -%}
            <p class="cart-item__meta">{{ property.first }}: {{ property.last }}</p>
          {%- endif -%}
        {%- endfor -%}
        <div class="cart-item__actions">
          <div class="qty qty--sm">
            <button type="button" data-qty-change="{{ item.key }}" data-qty="{{ item.quantity | minus: 1 }}" aria-label="Decrease quantity of {{ item.product.title | escape }}">−</button>
            <input type="number" value="{{ item.quantity }}" min="0" data-qty-input="{{ item.key }}" aria-label="Quantity of {{ item.product.title | escape }}">
            <button type="button" data-qty-change="{{ item.key }}" data-qty="{{ item.quantity | plus: 1 }}" aria-label="Increase quantity of {{ item.product.title | escape }}">+</button>
          </div>
          <button type="button" class="cart-item__remove" data-qty-change="{{ item.key }}" data-qty="0">Remove</button>
        </div>
      </div>
      <div class="cart-item__price">
        {%- if item.original_line_price > item.final_line_price -%}
          <s>{{ item.original_line_price | money }}</s>
        {%- endif -%}
        {{ item.final_line_price | money }}
        {%- for discount in item.line_level_discount_allocations -%}
          <span class="cart-item__discount">{% render 'icon', icon: 'tag', class: 'icon--sm' %} {{ discount.discount_application.title }}</span>
        {%- endfor -%}
      </div>
    </li>
  {%- endfor -%}
</ul>
