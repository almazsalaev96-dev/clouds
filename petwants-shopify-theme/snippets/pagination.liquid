{%- if paginate.pages > 1 -%}
  <nav aria-label="Pagination">
    <ul class="pagination">
      {%- if paginate.previous -%}
        <li><a href="{{ paginate.previous.url }}" aria-label="Previous page">{% render 'icon', icon: 'chevron-left', class: 'icon--sm' %}</a></li>
      {%- endif -%}
      {%- for part in paginate.parts -%}
        <li>
          {%- if part.is_link -%}
            <a href="{{ part.url }}" aria-label="Page {{ part.title }}">{{ part.title }}</a>
          {%- elsif part.title == paginate.current_page -%}
            <span aria-current="page">{{ part.title }}</span>
          {%- else -%}
            <span>{{ part.title }}</span>
          {%- endif -%}
        </li>
      {%- endfor -%}
      {%- if paginate.next -%}
        <li><a href="{{ paginate.next.url }}" aria-label="Next page">{% render 'icon', icon: 'chevron-right', class: 'icon--sm' %}</a></li>
      {%- endif -%}
    </ul>
  </nav>
{%- endif -%}
