{%- comment -%}
  Renders a stroke icon.
  Usage: {% render 'icon', icon: 'cart', class: 'icon--sm' %}
{%- endcomment -%}
{%- liquid
  assign cls = 'icon'
  if class
    assign cls = 'icon ' | append: class
  endif
-%}
