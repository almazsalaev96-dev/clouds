<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_brand }}">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">
    {%- else -%}
      <link rel="icon" type="image/png" href="{{ 'petwants-mark.png' | asset_url }}">
    {%- endif -%}

    {%- unless settings.type_header_font.system? -%}
      <link rel="preload" as="font" href="{{ settings.type_header_font | font_url }}" type="font/woff2" crossorigin>
    {%- endunless -%}
    {%- unless settings.type_body_font.system? -%}
      <link rel="preload" as="font" href="{{ settings.type_body_font | font_url }}" type="font/woff2" crossorigin>
    {%- endunless -%}

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; {{ current_tags | join: ', ' }}{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    {% render 'meta-tags' %}

    <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>

    {{ content_for_header }}

    {%- liquid
      assign body_font_bold = settings.type_body_font | font_modify: 'weight', 'bold'
      assign body_font_italic = settings.type_body_font | font_modify: 'style', 'italic'
      assign header_font_bold = settings.type_header_font | font_modify: 'weight', 'bolder'
    -%}
    {% style %}
      {{ settings.type_body_font | font_face: font_display: 'swap' }}
      {{ body_font_bold | font_face: font_display: 'swap' }}
      {{ body_font_italic | font_face: font_display: 'swap' }}
      {{ settings.type_header_font | font_face: font_display: 'swap' }}
      {{ header_font_bold | font_face: font_display: 'swap' }}

      :root {
        --font-body: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
        --font-body-weight: {{ settings.type_body_font.weight }};
        --font-heading: {{ settings.type_header_font.family }}, {{ settings.type_header_font.fallback_families }};
        --font-heading-weight: {{ settings.type_header_font.weight }};

        --c-brand: {{ settings.color_brand }};
        --c-brand-dark: {{ settings.color_brand | color_darken: 10 }};
        --c-brand-soft: {{ settings.color_brand | color_mix: '#ffffff', 14 }};
        --c-brand-tint: {{ settings.color_brand | color_mix: '#ffffff', 6 }};
        --c-on-brand: {{ settings.color_on_brand }};
        --c-ink: {{ settings.color_ink }};
        --c-ink-soft: {{ settings.color_ink | color_mix: '#ffffff', 72 }};
        --c-trust: {{ settings.color_trust }};
        --c-trust-soft: {{ settings.color_trust | color_mix: '#ffffff', 10 }};
        --c-save: {{ settings.color_save }};
        --c-save-soft: {{ settings.color_save | color_mix: '#ffffff', 10 }};
        --c-sale: {{ settings.color_sale }};
        --c-star: {{ settings.color_star }};
        --c-bg: {{ settings.color_background }};
        --c-bg-alt: {{ settings.color_background_alt }};
        --c-line: {{ settings.color_ink | color_mix: '#ffffff', 14 }};
        --c-line-soft: {{ settings.color_ink | color_mix: '#ffffff', 7 }};
        --radius: {{ settings.radius }}px;
        --radius-btn: {{ settings.radius_button }}px;
        --page-width: {{ settings.page_width }}px;
      }
    {% endstyle %}

    {{ 'theme.css' | asset_url | stylesheet_tag }}

    <script>
      document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
      window.PetWants = {
        routes: {
          root: {{ routes.root_url | json }},
          cart: {{ routes.cart_url | json }},
          cartAdd: {{ routes.cart_add_url | json }},
          cartChange: {{ routes.cart_change_url | json }},
          predictiveSearch: {{ routes.predictive_search_url | json }}
        },
        cartType: {{ settings.cart_type | json }},
        moneyFormat: {{ shop.money_format | json }},
        freeShippingThreshold: {{ settings.free_shipping_threshold | times: 100 | json }},
        strings: {
          addToCart: "Add to Cart",
          adding: "Adding…",
          added: "Added!",
          soldOut: "Sold out",
          unavailable: "Unavailable"
        }
      };
    </script>
  </head>

  <body class="template-{{ template.name }}{% if template.suffix %} template-{{ template.name }}--{{ template.suffix }}{% endif %}">
    <a class="skip-link" href="#MainContent">Skip to content</a>

    {% sections 'header-group' %}

    <main id="MainContent" class="main" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {%- if settings.cart_type == 'drawer' and template.name != 'cart' -%}
      {% section 'cart-drawer' %}
    {%- endif -%}

    {%- if settings.popup_enable -%}
      {% render 'email-popup' %}
    {%- endif -%}

    <div class="toast" id="Toast" role="status" aria-live="polite"></div>
  </body>
</html>
