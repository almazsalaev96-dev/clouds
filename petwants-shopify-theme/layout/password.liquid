<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{{ shop.name }}</title>
    {% render 'meta-tags' %}
    {{ content_for_header }}
    {{ settings.type_body_font | font_face: font_display: 'swap' }}
    {{ settings.type_header_font | font_face: font_display: 'swap' }}
    {% style %}
      :root {
        --font-body: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
        --font-body-weight: {{ settings.type_body_font.weight }};
        --font-heading: {{ settings.type_header_font.family }}, {{ settings.type_header_font.fallback_families }};
        --font-heading-weight: {{ settings.type_header_font.weight }};
        --c-brand: {{ settings.color_brand }};
        --c-brand-dark: {{ settings.color_brand | color_darken: 10 }};
        --c-brand-soft: {{ settings.color_brand | color_mix: '#ffffff', 14 }};
        --c-on-brand: {{ settings.color_on_brand }};
        --c-ink: {{ settings.color_ink }};
        --c-ink-soft: {{ settings.color_ink | color_mix: '#ffffff', 72 }};
        --c-trust: {{ settings.color_trust }};
        --c-trust-soft: {{ settings.color_trust | color_mix: '#ffffff', 10 }};
        --c-save: {{ settings.color_save }};
        --c-save-soft: {{ settings.color_save | color_mix: '#ffffff', 10 }};
        --c-bg: {{ settings.color_background }};
        --c-bg-alt: {{ settings.color_background_alt }};
        --c-line: {{ settings.color_ink | color_mix: '#ffffff', 14 }};
        --c-line-soft: {{ settings.color_ink | color_mix: '#ffffff', 7 }};
        --radius: {{ settings.radius }}px;
        --radius-btn: {{ settings.radius_button }}px;
        --page-width: {{ settings.page_width }}px;
      }
    {% endstyle %}
    {{ 'theme.css' | asset_url | stylesheet_tag }}
  </head>
  <body class="template-password">
    <main id="MainContent">{{ content_for_layout }}</main>
  </body>
</html>
