        "share": { "type": "share", "settings": {} }
      },
      "block_order": ["vendor", "title", "meta", "badges", "price", "variants", "purchase", "stock", "buy", "delivery", "assurance", "tab1", "tab2", "tab3", "tab4", "tab5", "share"],
      "settings": { "sticky_atc": true }
