{
  "name": "@slate/gateway",
  "version": "1.0.0",
  "private": true,
  "description": "Slate gateway: the only network peer the iPad app talks to. Holds provider secrets, enforces context budgets, and grades deterministically before any model is asked.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --experimental-strip-types test/*.test.ts",
    "start": "node --experimental-strip-types src/index.ts",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.123.0"
  },
  "devDependencies": {
    "@types/node": "22.7.5",
    "typescript": "5.6.3"
  }
}
