# ---------------------------------------------------------------------------
# Lodestar environment configuration
# Copy to .env.local and fill in. Never commit .env.local.
# ---------------------------------------------------------------------------

# --- AI provider -----------------------------------------------------------
# Lodestar runs fully without any AI key. Every deterministic engine (spaced
# repetition, mastery, priority, adaptive selection, mistake analysis,
# readiness, planning, mock exams, analytics) works offline and unaided.
# Setting a key additionally enables: the Tutor, AI marking of written answers,
# explanation generation, and question generation.
#
# Provider is selected by AI_PROVIDER. Supported: "anthropic" | "none"
AI_PROVIDER=none

# Anthropic (https://console.anthropic.com/)
ANTHROPIC_API_KEY=
# Model routing — cheap model for mechanical work, strong model for reasoning.
AI_MODEL_FAST=claude-haiku-4-5-20251001
AI_MODEL_REASONING=claude-opus-5

# Hard ceilings so a runaway loop cannot generate a large bill.
AI_MAX_TOKENS_PER_REQUEST=4000
AI_DAILY_REQUEST_BUDGET=500

# --- Persistence -----------------------------------------------------------
# Default persistence is local-first (IndexedDB in the browser). No database
# is required to run Lodestar. A Postgres adapter is planned; see
# docs/ARCHITECTURE.md ("Persistence seam") and db/schema.sql.
DATABASE_URL=
