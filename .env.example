# Server-side keys. Preferred: these never reach the browser, and a key set
# here means nobody visiting has to add one of their own — /api/chat uses it
# and Settings says "already configured server-side, nothing to do here".
#
# Copy this file to .env.local for local development; on a host, set the same
# names as environment variables (Vercel: Project -> Settings -> Environment
# Variables). Never commit a real key: .env*.local is ignored on purpose, and
# a key that reaches a branch is a key that has to be rotated.
# Any provider left blank can still be used by pasting a key in Settings,
# which stores it in this browser only and proxies through /api/chat.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MOONSHOT_API_KEY=
DEEPSEEK_API_KEY=

# Optional. Point a provider somewhere other than its own API — a gateway, a
# proxy, Azure, LiteLLM, or a local model serving an OpenAI-shaped endpoint.
# Unset, each falls back to the provider's real host.
# ANTHROPIC_BASE_URL=
# OPENAI_BASE_URL=
# Moonshot runs two APIs and a key works on exactly one of them: keys from
# platform.moonshot.ai against api.moonshot.ai (the default here), keys from
# platform.moonshot.cn against api.moonshot.cn. If Kimi reports a rejected key
# that you know is good, it is almost always the other one.
# MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
# DEEPSEEK_BASE_URL=

# --- MarketLab -------------------------------------------------------------
# MarketLab reads ANTHROPIC_API_KEY (above) for its Lab Assistant. The key is
# used only inside /api/lab-assistant, never sent to the browser, and never
# accepted from it. With no key the assistant still works: it answers from
# MarketLab's own lesson corpus and the numbers on the page, and labels the
# reply "Offline answer". Nothing else in the app needs a key.

# The model the Lab Assistant calls. Defaults to claude-sonnet-4-5.
# MARKETLAB_MODEL=claude-sonnet-4-5

# Set to `demo` to force the Data section onto clearly-labelled illustrative
# figures without attempting a live fetch. Useful offline, in CI, and in any
# environment with no outbound network. Unset, /api/indicators tries the World
# Bank API (which needs no key) and falls back to labelled demo data, with the
# reason, if it cannot be reached.
# MARKETLAB_DATA_MODE=demo
